{
  "name": "Demo application in Angular with Spring Boot and JPA",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --watch -c development --proxy-config proxy.conf.json",
    "start:proxy": "ng serve --watch -c development --proxy-config proxy.conf.json",
    "build": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
